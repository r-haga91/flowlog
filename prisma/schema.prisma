generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Festival {
  id            Int            @id @default(autoincrement())
  navn          String         @unique
  arrangementer Arrangement[]
  avlesninger   Avlesning[]

  @@map("festivaler")
}

model Arrangor {
  id          Int         @id @default(autoincrement())
  navn        String      @unique
  avlesninger Avlesning[]

  @@map("arrangorer")
}

model Arrangement {
  id          Int         @id @default(autoincrement())
  navn        String
  festivalId  Int
  festival    Festival    @relation(fields: [festivalId], references: [id], onDelete: Restrict)
  avlesninger Avlesning[]

  @@index([festivalId])
  @@unique([festivalId, navn])
  @@map("arrangementer")
}

model Avlesning {
  id             Int         @id @default(autoincrement())
  festivalId     Int
  arrangorId     Int
  arrangementId  Int
  dato           DateTime
  klokkeslett    String
  malerstand     Float
  kommentar      String?
  opprettetDato  DateTime    @default(now())
  festival       Festival    @relation(fields: [festivalId], references: [id], onDelete: Restrict)
  arrangor        Arrangor     @relation(fields: [arrangorId], references: [id], onDelete: Restrict)
  arrangement     Arrangement @relation(fields: [arrangementId], references: [id], onDelete: Restrict)

  @@index([festivalId])
  @@index([arrangorId])
  @@index([arrangementId])
  @@index([opprettetDato])
  @@map("avlesninger")
}

model Profile {
  id         Int      @id @default(autoincrement())
  authUserId String   @unique
  email      String   @unique
  name       String
  role       String   @default("LESER")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([role, isActive])
  @@map("profiles")
}
